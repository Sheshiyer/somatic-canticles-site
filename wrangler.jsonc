{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "somatic-canticles-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    // only video goes through the Worker (byte ranges for Safari/iOS); everything else is plain static assets
    "run_worker_first": ["/assets/*.mp4"]
  },
  "routes": [
    { "pattern": "somatic.tryambakam.space", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
